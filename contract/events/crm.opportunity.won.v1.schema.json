{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/crm-opportunity/events/crm.opportunity.won.v1.schema.json",
  "title": "crm.opportunity.won.v1",
  "description": "An incremental fact: the opportunity was won, by a user or by a sales document's event (OP06, OP08); a reopened opportunity won again publishes a new fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_id",
    "opportunity_id",
    "legal_entity_id",
    "owner_id",
    "customer_id",
    "won_amount",
    "currency",
    "trigger",
    "occurred_at"
  ],
  "properties": {
    "fact_id": {
      "type": "string",
      "format": "uuid"
    },
    "opportunity_id": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "won_amount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "a non-negative decimal string in the currency's minor units"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "document_id"
      ],
      "description": "what caused the change: a user's command, or a sales document's event (automatic win, OP08)",
      "properties": {
        "kind": {
          "enum": [
            "user",
            "quotation",
            "sales_order"
          ]
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "the sales document; null for user"
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
